[
  {
    "name": "gemini",
    "base_url": "https://generativelanguage.googleapis.com/v1beta/openai",
    "api_key_env": "GEMINI_API_KEY",
    "model": "gemini-2.5-flash"
  },
  {
    "name": "nvidia",
    "base_url": "https://integrate.api.nvidia.com/v1",
    "api_key_env": "NVIDIA_API_KEY",
    "model": "meta/llama-3.3-70b-instruct"
  },
  {
    "name": "claude-code",
    "_comment": "local Claude Code wrapper. If it speaks OpenAI /chat/completions, delete format/path/payload/response_path and just set base_url. If it is Anthropic-shaped, set format to anthropic.",
    "format": "custom",
    "base_url": "http://127.0.0.1:PORT",
    "path": "/PATH",
    "api_key_env": "",
    "auth": "bearer",
    "model": "claude-code",
    "payload": {
      "prompt": "{prompt}"
    },
    "response_path": "response"
  }
]
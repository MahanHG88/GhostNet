# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# The only chat id allowed to run commands and receive the audit trail
ADMIN_CHAT_ID=

# How long to wait for Ms. Garcia to answer herself before Mr. Alvarez steps in
REPLY_DELAY_MINUTES=5

# Never answer twice in the same chat inside this window
REPLY_COOLDOWN_MINUTES=30

# Hard cap on automatic replies per chat per day
MAX_REPLIES_PER_CHAT_PER_DAY=5

# How many times Mr. Alvarez answers one person before the fixed warnings start,
# and how many warnings they get before he goes quiet in that chat for good.
# Both reset the moment she writes to that person herself.
AI_REPLY_LIMIT=4
WARNING_LIMIT=4

# Chat ids exempt from those limits, for people she wants exempt without naming them.
# People she has named live in contacts.json instead - they are exempt too, and get
# greeted by name. Either way they hear her availability exactly rather than vaguely.
EXEMPT_CHAT_IDS=

# API keys for whatever providers.json references
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
